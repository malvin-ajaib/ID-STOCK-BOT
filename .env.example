# Copy this file to ".env" and fill in your real credentials.
# The .env file is git-ignored and must never be committed.

# Account 1 — used for BUY.
AJAIB_EMAIL=malvin.rdn+10@ajaib.co.id
AJAIB_PASSWORD=Ajaib123!
# PIN used to validate the login (exchanges the pin_token for an access token).
AJAIB_PIN_CODE=1234
AJAIB_USER_ID=1

# Account 2 — used for SELL. Leave commented to reuse account 1.
# AJAIB_SELL_EMAIL=malvin.rdn+11@ajaib.co.id
# AJAIB_SELL_PASSWORD=Ajaib123!
# AJAIB_SELL_PIN_CODE=1234
# AJAIB_SELL_USER_ID=1

# Global base URL for every API call.
AJAIB_BASE_URL=https://sm-ple.ajaib.tech

# Stock code to fetch (hardcoded default, overridable here).
AJAIB_STOCK_CODE=BMRI

# Fallback "current price" — used only if the order book side is empty AND the
# price-detail API is unavailable. (ARA/ARB always come from the price API.)
AJAIB_FALLBACK_PRICE=50

# Random mode (--random): lot range, tick range, and interval between orders.
AJAIB_RANDOM_LOT_MIN=100
AJAIB_RANDOM_LOT_MAX=5000
AJAIB_RANDOM_TICKS_MIN=1
AJAIB_RANDOM_TICKS_MAX=5
AJAIB_RANDOM_INTERVAL_SECONDS=3

# Liquidity injection on sell failure (e.g. HTTP 425): top up this many lots and
# retry the sell once, after this delay (lets the credit settle).
AJAIB_LIQUIDITY_INJECT_LOT=50000
AJAIB_LIQUIDITY_RETRY_DELAY_SECONDS=1

# ==========================================================================
# DEVICE PROFILE SWITCH  ->  set to IOS or ANDROID
# Controls which header set + login platform the bot uses.
# ==========================================================================
AJAIB_DEVICE_PROFILE=IOS

# --- Shared (both profiles) ---
X_DEVICE_SIGNATURE=qa-test-automation-1
X_APP_MODE=PRO
X_PRODUCT=stock-mf
ACCEPT_LANGUAGE=id

# --- iOS profile (used when AJAIB_DEVICE_PROFILE=IOS) ---
X_IOS_VER_ID=81C81887-5BD8-41D9-B0E1-1559CD6A8740
X_IOS_VER_NAME=6.99.0202605241939
X_IOS_VER_CODE=6.99.0
USER_AGENT_IOS=iOS-6.99.0

# --- Android profile (used when AJAIB_DEVICE_PROFILE=ANDROID) ---
X_ANDROID_VER_ID=81C81887-5BD8-41D9-B0E1-1559CD6A8740
X_ANDROID_VER_NAME=6.99.0202605241939
X_ANDROID_VER_CODE=6.99.0
USER_AGENT_ANDROID=Android-6.99.0
